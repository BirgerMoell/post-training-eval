{
  "schema_version": 1,
  "id": "multilingual",
  "name": "Multilingual",
  "question": "Is the model useful across all 36 project languages, including the weakest language tier?",
  "gate_policy": "macro_p10_min_and_tier_gap",
  "benchmarks": [
    {"id": "mmlu-prox", "name": "MMLU-ProX EU", "metric": "exact_match", "direction": "higher", "target": 50, "stretch": 72, "runner": "oellm-eval", "group": "mmlu-prox-eu", "status": "operational"},
    {"id": "global-mmlu", "name": "Global MMLU EU", "metric": "accuracy", "direction": "higher", "target": 70, "stretch": 82, "runner": "oellm-eval", "group": "global-mmlu-eu", "status": "operational"},
    {"id": "sib-200", "name": "SIB-200 EU", "metric": "accuracy_normalized", "direction": "higher", "runner": "oellm-eval", "group": "sib200-eu", "status": "operational"},
    {"id": "belebele", "name": "Belebele EU", "metric": "accuracy_normalized", "direction": "higher", "runner": "oellm-eval", "group": "belebele-eu-5-shot", "status": "operational"},
    {"id": "flores-200", "name": "FLORES-200 bidirectional EU", "metric": "chrf++", "direction": "higher", "runner": "oellm-eval", "group": "flores-200-eu-to-eng,flores-200-eng-to-eu", "status": "operational"},
    {"id": "include", "name": "INCLUDE", "metric": "accuracy", "direction": "higher", "target": 74, "stretch": 82, "runner": "oellm-eval", "group": "include", "status": "operational"},
    {"id": "eu-language-fidelity", "name": "EU language fidelity", "metric": "correct_language_rate", "direction": "higher", "target": 98, "runner": "openai-endpoint", "status": "operational"},
    {"id": "xwinograd", "name": "XWinograd", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "generic-multilingual", "status": "operational"},
    {"id": "xcopa", "name": "XCOPA", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "generic-multilingual", "status": "operational"},
    {"id": "xstorycloze", "name": "XStoryCloze", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "generic-multilingual", "status": "operational"},
    {"id": "xcsqa", "name": "X-CSQA", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "xcsqa-eu", "status": "operational"},
    {"id": "paws-x", "name": "PAWS-X", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "pawsx-eu", "status": "operational"},
    {"id": "xnli", "name": "XNLI", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "xnli-eu", "status": "operational"},
    {"id": "opensubtitles-multi40", "name": "OpenSubtitles Multi40 translation", "metric": "bleu", "direction": "higher", "runner": "oellm-eval", "group": "opensubtitles-eu-en-xx,opensubtitles-eu-xx-en", "status": "operational"},
    {"id": "arc-challenge-mt", "name": "ARC-Challenge MT EU", "metric": "accuracy_normalized", "direction": "higher", "runner": "oellm-eval", "group": "arc-challenge-mt-eu", "status": "operational"},
    {"id": "global-piqa", "name": "Global PIQA EU", "metric": "accuracy", "direction": "higher", "runner": "oellm-eval", "group": "global-piqa-eu-completions,global-piqa-eu-prompted", "status": "operational"}
  ],
  "required_aggregations": ["macro", "p10", "minimum", "tier-1", "tier-2", "tier-3", "max-tier-gap"]
}
