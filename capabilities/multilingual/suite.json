    {"id": "global-mmlu", "name": "Global MMLU EU", "metric": "accuracy", "direction": "higher", "target": 70, "stretch": 82, "runner": "oellm-eval", "group": "global-mmlu-eu", "status": "operational", "sources": [{"label": "Dataset", "url": "https://huggingface.co/datasets/CohereForAI/Global-MMLU"}]},
