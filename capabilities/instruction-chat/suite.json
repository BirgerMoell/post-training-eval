{
  "schema_version": 1,
  "id": "instruction-chat",
  "name": "Instruction & Chat",
  "question": "Does the model follow explicit, compositional, and conversational instructions in target languages?",
  "gate_policy": "retention_and_multilingual_floor",
  "target_policy": "program-floor-v1",
  "benchmarks": [
    {"id": "ifeval", "name": "IFEval", "metric": "prompt_level_strict_accuracy", "direction": "higher", "target": 75, "stretch": 90, "runner": "oellm-eval", "group": "reasoning", "status": "operational", "sources": [{"label": "Dataset", "url": "https://huggingface.co/datasets/google/IFEval"}]},
    {"id": "ifbench", "name": "IFBench", "metric": "accuracy", "direction": "higher", "target": 60, "stretch": 76, "runner": "external", "status": "adapter-required", "sources": [{"label": "Benchmark & data", "url": "https://github.com/allenai/IFBench"}]},
    {"id": "maxife", "name": "MultiChallenge/MaXIFE", "metric": "accuracy", "direction": "higher", "target": 80, "stretch": 88, "runner": "external", "status": "adapter-required", "sources": [{"label": "MultiChallenge dataset", "url": "https://huggingface.co/datasets/ScaleAI/MultiChallenge"}, {"label": "MaXIFE data & runner", "url": "https://github.com/OPPO-Mente-Lab/MaXIFE"}]},
    {"id": "arena-hard-eu", "name": "ArenaHard-EU", "metric": "win_rate", "direction": "higher", "target": 50, "runner": "external", "status": "adapter-required", "sources": [{"label": "Dataset", "url": "https://huggingface.co/datasets/openeurollm/ArenaHard-EU-v0"}]},
    {"id": "lmarena-rank", "name": "LMArena rank", "metric": "rank", "direction": "lower", "target": 200, "stretch": 50, "runner": "external", "status": "submission-required", "sources": [{"label": "Live leaderboard", "url": "https://arena.ai/leaderboard"}]},
    {"id": "oellm-instruction-holdouts", "name": "OpenEuroLLM instruction holdouts", "metric": "instruction_following_accuracy", "direction": "higher", "target": 75, "stretch": 90, "runner": "openai-endpoint", "status": "operational", "sources": [{"label": "Dataset", "url": "https://huggingface.co/datasets/birgermoell/oellm-eu-eval-holdouts-v1"}]},
    {"id": "oellm-summary-holdouts", "name": "OpenEuroLLM constrained summarization holdouts", "metric": "required_points_accuracy", "direction": "higher", "target": 70, "stretch": 88, "runner": "openai-endpoint", "status": "operational", "sources": [{"label": "Dataset", "url": "https://huggingface.co/datasets/birgermoell/oellm-eu-eval-holdouts-v1"}]}
  ]
}
