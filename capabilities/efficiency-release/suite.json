{
  "schema_version": 1,
  "id": "efficiency-release",
  "name": "Efficiency & Release",
  "question": "Is the release complete, reproducible, fast enough, and robust after quantization?",
  "gate_policy": "all_artifacts_and_quantization_retention_required",
  "target_policy": "program-floor-v1",
  "benchmarks": [
    {"id": "checkpoint-compatibility", "name": "Checkpoint compatibility", "metric": "checks_pass_rate", "direction": "higher", "target": 100, "stretch": 100, "runner": "inspect", "status": "operational", "sources": [{"label": "Evaluation contract", "url": "https://github.com/BirgerMoell/post-training-eval/blob/main/capabilities/efficiency-release/suite.json"}]},
    {"id": "throughput", "name": "Serving throughput", "metric": "output_tokens_per_second", "direction": "higher", "target": 15, "stretch": 30, "runner": "external", "status": "adapter-required", "sources": [{"label": "Evaluation contract", "url": "https://github.com/BirgerMoell/post-training-eval/blob/main/capabilities/efficiency-release/suite.json"}]},
    {"id": "time-to-first-token", "name": "Time to first token", "metric": "milliseconds", "direction": "lower", "target": 2000, "stretch": 1000, "runner": "external", "status": "adapter-required", "sources": [{"label": "Evaluation contract", "url": "https://github.com/BirgerMoell/post-training-eval/blob/main/capabilities/efficiency-release/suite.json"}]},
    {"id": "quantization-retention", "name": "Quantization retention", "metric": "macro_score_loss_points", "direction": "lower", "target": 1, "stretch": 0.5, "runner": "external", "status": "adapter-required", "sources": [{"label": "Evaluation contract", "url": "https://github.com/BirgerMoell/post-training-eval/blob/main/capabilities/efficiency-release/suite.json"}]},
    {"id": "release-completeness", "name": "Release artifact completeness", "metric": "checks_pass_rate", "direction": "higher", "target": 100, "stretch": 100, "runner": "inspect", "status": "operational", "sources": [{"label": "Evaluation contract", "url": "https://github.com/BirgerMoell/post-training-eval/blob/main/capabilities/efficiency-release/suite.json"}]}
  ]
}
